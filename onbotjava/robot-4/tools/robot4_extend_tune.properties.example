# Copy to /sdcard/FIRST/robot4_extend_tune.properties only after limits are measured.
# Missing file => monitor only. Provisional test thresholds below are NOT manufacturer ratings.
# Start with monitor only. Confirm voltage/current and mechanical support before enabling motion.
motion_enabled=false
motor_model=REV_Core_Hex
gear_ratio=user_reported_10.4_reduction
balls=-1
# PID (manual), STEP_POS, STEP_NEG, BREAKAWAY_POS, BREAKAWAY_NEG.
# Non-PID trials require known balls and train/validation role. No automatic sequence of trials.
trial_mode=PID
dataset_role=unspecified
step_deg=5
slew_dps=10
# Verify motor-controller and Hub connection information on telemetry BEFORE selecting this.
# BREAKAWAY requires the correct motor Hub index; -1 means not assigned.
motor_hub_index=-1
# Sign of sensor-angle change for positive motor voltage: same=1, opposite=-1.
motor_to_angle_sign=1
ramp_rate_V_per_s=0.4
ramp_max_delta_V=1.0
ramp_max_excursion_deg=3.0
min_angle_deg=1
max_angle_deg=75
motor_limit_A=2.0
hub_limit_A=8.0
min_voltage_V=11.0
max_power=0.25
# Starting coefficients from 1547d2a, NOT newly tuned or validated for this gear ratio.
kp=0.0175
ki=0.005
kd=0
gravity_cos=0.0638
gravity_constant=0.0694
gravity_phase_deg=17
friction=0.123
