# 4号機 足回り計測 Drive_Tune_R4 の設定例。/sdcard/FIRST/robot4_drive_tune.properties に置く。
# motion_enabled=false のままでは動かない（INITから計測と表示のみ）。
# 下の制限値は初回試験用の控えめな候補で、機器の保証値ではない。
motion_enabled=false

# 記録用の文字列（ユーザー申告: 25:1 = 5:1+5:1 から 15:1 = 5:1+3:1 へ変更）
gear_ratio=UltraPlanetary_5:1+3:1_nominal15_from_5:1+5:1_nominal25
motor_model=REV_HD_Hex

# 実際の減速比（モーター回転数/車輪回転数）。5:1実比5.23 × 3:1実比2.89 = 15.15。
# 車輪までにスプロケット等の別の減速があれば、その比も掛ける。
gear_reduction=15.15
# HD Hexモーター軸のエンコーダーは1回転28カウント。
counts_per_motor_rev=28
# 車輪の直径[mm]。実測して書き、行頭の#を外す。未記入では動作を有効にできない。
#wheel_diameter_mm=

# 出力上限（1.0以下）。最初は0.5までで試し、問題なければ上げる。
max_power=0.5
# STRAIGHTの走行距離[m]。ここで自動的にブレーキへ移る。停止距離ぶんの余裕を床に確保する。
max_travel_m=1.5
# TURNの旋回角[deg]。ここで自動的にブレーキへ移る。
max_turn_deg=180
# 1回の走行・旋回の最長時間[ms]（5000以下）。
run_ms=1500
brake_timeout_ms=3000
heading_ms=3000

# 十字上下で選ぶ出力と、HEADINGの目標角度。
powers=0.3,0.5
heading_steps_deg=45,90,180

# 加速: 1秒あたりの出力変化。0は即時（現在の本番と同じ）。
accel_per_s=0
# RAMPブレーキ: 1秒あたりの出力減少。0は即時0（逆向きパルスなし）。
# Yで本番と同じMATCHブレーキと切り替えて比べる。
brake_per_s=2.0

# HEADINGのゲインを試すときだけ書く。未記入なら本番ImuControllerの値（換算済み）。
#imu_kp=0.0221
#imu_kd=0.00221
#imu_ks=0.0554
#imu_max_turn_power=1.0
